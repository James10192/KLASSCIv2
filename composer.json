{
    "name": "esbtp/esbtp-yakro-v2",
    "type": "project",
    "description": "Système de gestion d'école ESBTP YAKRO - Version 2",
    "keywords": [
        "laravel",
        "school-management",
        "esbtp",
        "yakro"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^3.0",
        "google-gemini-php/laravel": "^2.0",
        "guzzlehttp/guzzle": "^7.2",
        "jenssegers/agent": "^2.6",
        "laravel-notification-channels/webpush": "^10.0",
        "laravel/framework": "^12.68",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^4.0",
        "maatwebsite/excel": "^3.1",
        "mpdf/mpdf": "^8.2",
        "owen-it/laravel-auditing": "^14.0",
        "pragmarx/google2fa": "^9.1",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^11.5.50",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/ci-local.sh"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-2cx9-ynrq-qdk3": "Dépendance indirecte via laravel/framework. league/commonmark non utilisé pour parser du contenu utilisateur. DoS non applicable.",
                "GHSA-3q6v-r5mr-hxv8": "Nouvel avis sur league/commonmark <= 2.10.1 (scan quadratique des tableaux GFM). Le projet ne passe aucun contenu utilisateur par CommonMark/GFM et la dépendance est transitive : le vecteur de DoS n'est pas exposé dans KLASSCI. Risque accepté explicitement jusqu'à la prochaine montée de dépendances compatible.",
                "PKSA-4s4z-t146-6123": "psy/psysh est une dépendance de laravel/tinker, non utilisé en production. Vecteur local non applicable."
            }
        },
        "platform": {
            "php": "8.3.31"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
