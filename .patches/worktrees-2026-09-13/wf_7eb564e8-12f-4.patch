+@include('partials._klassci_toast')
+
+<script>
+document.addEventListener('DOMContentLoaded', function () {
+    var btn = document.getElementById('bulRegenerateBtn');
+    if (!btn) return;
+
+    btn.addEventListener('click', function () {
+        var csrf = document.querySelector('meta[name="csrf-token"]');
+        if (!csrf) return;
+
+        btn.disabled = true;
+
+        fetch(btn.dataset.url, {
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+                'Accept': 'application/json',
+                'X-CSRF-TOKEN': csrf.getAttribute('content'),
+                'X-Requested-With': 'XMLHttpRequest'
+            },
+            body: JSON.stringify({
+                etudiant_id: btn.dataset.etudiantId,
+                classe_id: btn.dataset.classeId,
+                annee_universitaire_id: btn.dataset.anneeId,
+                periode: btn.dataset.periode
+            })
+        })
+        .then(function (res) {
+            return res.json()
+                .catch(function () { return { ok: false, message: 'Réponse serveur illisible (HTTP ' + res.status + ')' }; })
+                .then(function (data) { return { httpOk: res.ok, data: data }; });
+        })
+        .then(function (result) {
+            if (!result.httpOk || !result.data.ok) {
+                btn.disabled = false;
+                window.klassciToast('error', result.data.message || 'Le recalcul a échoué.');
+                if (result.data.redirect_url) {
+                    setTimeout(function () { window.location.href = result.data.redirect_url; }, 1500);
+                }
+                return;
+            }
+            window.klassciToast('success', result.data.message || 'Bulletin recalculé.');
+            // EXCEPTION ajax-no-reload-premium : moyennes, rang et mention sont rendus
+            // côté serveur sur toute la page — les rafraîchir un à un dupliquerait le gabarit.
+            setTimeout(function () { window.location.reload(); }, 900);
+        })
+        .catch(function () {
+            btn.disabled = false;
+            window.klassciToast('error', 'Le recalcul a échoué (réseau).');
+        });
+    });
+});
+</script>
 @endsection
