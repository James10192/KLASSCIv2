# Les quatre variables à renseigner dans Dokploy (onglet Environment) pour une école.
# Modèle seulement : ne jamais committer un fichier rempli.
NOM_ECOLE=Lycée Exemple
CODE_ECOLE=lycee-exemple
DOMAINE=lycee-exemple.klassci.com
MOT_DE_PASSE_BASE=

# Facultatif
# FUSEAU=Africa/Abidjan          (hors Côte d'Ivoire : voir docs/runbooks/ucao-benin-mise-en-service.md, à poser AVANT l'installation)
# MAIL_MAILER=smtp  MAIL_HOST=  MAIL_PORT=465  MAIL_USERNAME=  MAIL_PASSWORD=  MAIL_ENCRYPTION=ssl  MAIL_FROM_ADDRESS=
# MASTER_API_URL=  MASTER_API_TOKEN=  GROUP_SSO_SHARED_SECRET=
