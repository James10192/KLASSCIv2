# Modèle. Copier en presentation.env et remplir. Ne jamais committer le fichier rempli.
APP_NAME=KLASSCI
APP_ENV=production
APP_DEBUG=false
# Même valeur que sur LWS : sans elle, sessions et données chiffrées sont illisibles.
APP_KEY=
APP_URL=https://presentation.klassci.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=klassci_presentation
DB_USERNAME=klassci
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Même valeurs que DB_* ci-dessus : lues par l'image MySQL au premier démarrage.
MYSQL_DATABASE=klassci_presentation
MYSQL_USER=klassci
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Désactiver le planificateur des autres serveurs pour cette instance avant de la lancer.
# Clés de messagerie, MailPulse et clés propres à l'école : à reprendre de LWS, une à une.
