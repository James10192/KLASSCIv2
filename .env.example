# Required
ANTHROPIC_API_KEY=your-api-key-here  # For most AI ops -- Format: sk-ant-api03-... (Required)
PERPLEXITY_API_KEY=pplx-abcde        # For research -- Format: pplx-abcde (Optional, Highly Recommended)

# Optional - defaults shown
MODEL=claude-3-7-sonnet-20250219  # Recommended models: claude-3-7-sonnet-20250219, claude-3-opus-20240229 (Required)
PERPLEXITY_MODEL=sonar-pro        # Make sure you have access to sonar-pro otherwise you can use sonar regular (Optional)
MAX_TOKENS=64000                   # Maximum tokens for model responses (Required)
TEMPERATURE=0.2                   # Temperature for model responses (0.0-1.0) - lower = less creativity and follow your prompt closely (Required)
DEBUG=false                       # Enable debug logging (true/false)
LOG_LEVEL=info                    # Log level (debug, info, warn, error)
DEFAULT_SUBTASKS=5                # Default number of subtasks when expanding
DEFAULT_PRIORITY=medium           # Default priority for generated tasks (high, medium, low)
PROJECT_NAME=klassci      # Project name for tasks.json metadata

# Groq (Chatbot LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT=20
GROQ_TEMPERATURE=0.2
GROQ_TOP_P=0.9
GROQ_MAX_TOKENS=600

# MailPulse test notifications
TENANT_CODE=your-tenant-code
MAILPULSE_ENABLED=true
MAILPULSE_BASE_URL=https://mailpulse-two.vercel.app
MAILPULSE_API_KEY=
MAILPULSE_TIMEOUT=20
# Rail applications externes MailPulse (chatbot parents uniquement).
# Fournis par le provisioning MailPulse, affiches une seule fois.
MAILPULSE_EXTERNAL_APPLICATION_KEY=
MAILPULSE_EXTERNAL_ORGANIZATION_ID=
MAILPULSE_EXTERNAL_COMMAND_KEY_ID=
MAILPULSE_EXTERNAL_COMMAND_SECRET=
MAILPULSE_EXTERNAL_CALLBACK_KEY_ID=
MAILPULSE_EXTERNAL_CALLBACK_SECRET=
# Interrupteur maitre des workflows reels. Laisser a false hors pilote.
MAILPULSE_REAL_WORKFLOWS_ENABLED=false
MAILPULSE_PARENT_CHATBOT_SERVICE_SECRET=
MAILPULSE_PARENT_CHATBOT_WEBHOOK_SECRET=
MAILPULSE_PARENT_CHATBOT_CODE_PEPPER=
MAILPULSE_PARENT_CHATBOT_PHONE_HASH_KEY=
MAILPULSE_PARENT_CHATBOT_SIGNATURE_TTL=300
MAILPULSE_PARENT_CHATBOT_LINK_CODE_TTL=15
MAILPULSE_PARENT_CHATBOT_REPORT_CARD_TTL_HOURS=48
# Confirmation operateur que le template Meta d'activation existe. Le nom reel
# du template est resolu par MailPulse via l'operation parent_chatbot.link_code.
MAILPULSE_PARENT_CHATBOT_LINK_TEMPLATE_NAME=
MAILPULSE_PARENT_CHATBOT_LINK_TEMPLATE_LANGUAGE=fr
# Invitation d'activation en lot, categorie UTILITY, sans code. Le nom reel du
# template Meta est resolu par MailPulse via l'operation
# parent_chatbot.invitation : cette valeur est une confirmation operateur.
MAILPULSE_PARENT_CHATBOT_INVITATION_TEMPLATE_NAME=
MAILPULSE_PARENT_CHATBOT_INVITATION_TEMPLATE_LANGUAGE=fr
MAILPULSE_CONTACTS_ENDPOINT=/api/v1/contacts
MAILPULSE_MESSAGES_ENDPOINT=/api/v1/messages
MAILPULSE_SENDER_EMAIL=
MAILPULSE_SENDER_NAME=KLASSCI
MAILPULSE_DEFAULT_LANGUAGE=fr
TEST_API_SECRET=
TEST_NOTIFICATION_EMAIL=
TEST_NOTIFICATION_PHONE=
