<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Fichiers versionnés (?v=...) : l'URL change a chaque modification, le
    # navigateur peut donc les garder un an sans jamais redemander.
    RewriteCond %{QUERY_STRING} (^|&)v= [NC]
    RewriteRule \.(css|js|woff2?|ttf|svg|png|jpe?g|webp|gif|ico)$ - [E=ASSET_VERSIONNE:1]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Force HTTPS (si SSL est activé)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Refus explicite de tout fichier .env (.env, .env.backup-*, .env.example).
# La racine web est public/, donc ces fichiers ne sont deja pas servis — mais
# cette protection depend d une reecriture sous <IfModule mod_rewrite.c>, qui
# disparait en silence si le module manque ou si AllowOverride change.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Cache du navigateur.
#
# Ce bloc remplace un « no-cache, no-store » pose « pour le developpement » et
# reste en production : chaque clic retelechargeait la vingtaine de feuilles et
# de scripts de l'application, avant meme d'afficher la page.
#
# - Pages PHP : jamais en cache (donnees personnelles, postes partages).
# - CSS / JS non versionnes : gardes, mais revalides a chaque usage. Le serveur
#   repond 304 sans renvoyer le fichier tant qu'il n'a pas change ; un
#   deploiement est donc vu immediatement.
# - Fichiers versionnes (?v=) : un an, sans revalidation.
# - Images et polices : une semaine.
#
# FilesMatch est applique apres les directives du dossier : il l'emporte sur
# la regle generale des pages.
#
# L'ordre des deux lignes de chaque bloc est voulu. LiteSpeed ignore en silence
# ce qu'il ne reconnait pas. S'il ignorait la condition « env= », la DERNIERE
# ligne l'emporterait : c'est donc la prudente (revalidation), jamais
# l'« immutable », qui aurait fige un an tous les fichiers non versionnes.
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0

    <FilesMatch "\.(css|js)$">
        Header unset Pragma
        Header unset Expires
        Header set Cache-Control "public, max-age=31536000, immutable" env=ASSET_VERSIONNE
        Header set Cache-Control "public, no-cache" env=!ASSET_VERSIONNE
    </FilesMatch>

    <FilesMatch "\.(woff2?|ttf|eot|svg|png|jpe?g|webp|gif|ico)$">
        Header unset Pragma
        Header unset Expires
        Header set Cache-Control "public, max-age=31536000, immutable" env=ASSET_VERSIONNE
        Header set Cache-Control "public, max-age=604800" env=!ASSET_VERSIONNE
    </FilesMatch>
</IfModule>
